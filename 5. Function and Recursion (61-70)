# 61. Write a recursive factorial function.
def factorial_recusive(n):
    return 1 if n == 0 else n * factorial_recusive(n -1)
print(factorial_recusive(5))



# 62. Write a recursive fibonacci function.

def fib_recursive(n):
    return n if n <= 1 else fib_recursive(n-1) + fib_recursive(n-2)
print(fib_recursive(7))



# 63. Sum a list using recursion.

def sum_recurive(lst):
    return 0 if not lst else lst[0] + sum_recurive(lst[1:])
print(sum_recurive([1,2,3,4]))



# 64. Find the power of a number using recursion.

def power_recursion(base, exp):
    return 1 if exp == 0 else base * power_recursion(base, exp - 1)
print(power_recursion(2,5))



# 65. Implement recursive binary search.

def binary_search_recursive(arr, target, low=0, high = None):
    if high is None:
        high = len(arr) - 1
    if low > high:
        return -1
    mid = (low - high) // 2
    if arr[mid] == target:
        return mid
    elif arr[mid] < target:
        return binary_search_recursive(arr, target, mid + 1, high)
    else:
        return binary_search_recursive(arr, target, low, mid -1)
print(binary_search_recursive([1,3,5,7,9,11],7))



