# 25. Check if two strings are anagrams.

def is_anagram(s1, s2):
    return sorted(s1.lower()) == sorted(s2.lower())
print(is_anagram("listen","silent"))



# 26. Remove duplicate characters from a string.

def remove_duplicate_str(s):
    seen = set()
    result = []
    for c in s:
        if c not in seen:
            seen.add(c)
            result.append(c)
    return ''.join(result)
print(remove_duplicate_str("programming"))



# 27. Find the most frequent character in a string.

def most_frequent_char(s):
    return max(set(s), key=s.count)
print(most_frequent_char("aabbbcc"))



