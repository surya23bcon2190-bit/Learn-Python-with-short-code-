# 22. Check if a string is a palindrome.

def is_palindrome_str(s):
    return s == s[::-1]
print(is_palindrome_str("madam"))
    


# 23. Count the vowels in a string.

def count_vowels(s):
    return sum(1 for c in s.lower() if c in 'aeiou')
print(count_vowels("HEloow World"))



