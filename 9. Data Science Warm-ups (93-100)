# 94. Calculate standard deviation manually, without a library.

def std_dev_manual(lst):
    mean = sum(lst) / len(lst)
    variance = sum((x - mean) ** 2 for x in lst) / len(lst)
    return variance ** 0.5
print(std_dev_manual([2,4,4,4,5,5,7,9]))



