# 13. Build a Simple calculator

def calculator(a,b,op):
    if op == '+': return a + b
    elif op == '-': return a - b
    elif op == '*': return a * b
    elif op == '/': return a / b 
print(calculator(3, 4,'*'))



# 14. Check if a yer is a leap year

def is_leap_year(y):
    return y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)
print(is_leap_year(2004))



# 15. Find the GCD of two numbers

def gcd(a, b):
    while b:
        a, b = b , a % b
    return a 
print(gcd(48, 18))



# 16. Find the LCM of two numbers.

def lcm(a, b):
    return a * b // gcd(a,b)
print(lcm(4, 6))



# 17. Print a multiplication table.

def multiplication_table(n):
    return[n * i for i in range(1, 11)]
print(multiplication_table(6))



# 18. Sum the first N natural numbers.

def sum_natural(n):
    return n * (n + 1) // 2
print(sum_natural(10))



# 19. Count the digit in a number. 

def count_digits(n):
