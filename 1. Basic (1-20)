# 05. Check if a number is prime.

def is_prime(n):
    if n < 2:
        return False
    for i in range(2, int(n**0.5) + 1):
        if n % i==0:
            return False
    return True
print(is_prime(17))



# 06.Print the Fibonacci series.

def fibonacci(n):
    a, b = 0,1
    seq = []
    for _ in range(n):
        seq.append(a)
        a, b = b , a + b
    return seq
print(fibonacci(10))



# 07. Calculate a factorial

def factorial(n):
    return 1 if n == 0 else n * factorial( n - 1)
print(factorial(5))



# 08.Check if a number is a palindrome.

def is_palindrome_num(n):
    return str(n) == str(n)[::-1]
print(is_palindrome_num(121))



# 09. Reverse a number

def reverse_num(n):
    return int(str(n)[::-1])
print(reverse_num(12341))



# 10. Sum the digit of a number

def sum_of_digit(n):
    return sum(int(d) for d in str(n))
print(sum_of_digit(12345))



# 11. Check for an Armstrong number

def is_armstrong(n):
    digit = str(n)
    power = len(digit)
    return n == sum(int(d) ** power for d in  digit)
print(is_armstrong(153))



