# 40. Sort a list without using sort().

def bubble_sort(lst):
    lst = lst.copy()
    n = len(lst)
    for i in range(n):
        for j in range(n- i -1):
            if lst[j] > lst[j + 1]:
                lst[j], lst[j + 1] = lst[j + 1], lst[j]
    return lst
print(bubble_sort([5,3,7,2,1,8,4,2]))



